{
  "schemaVersion": 1,
  "id": "katomap",
  "version": "${version}",
  "name": "Xaero's Katomap",
  "description": "Maquete 3D do terreno explorado: gire, incline, mova e dê zoom. Addon independente para uso ao lado do Xaero's World Map / Minimap.",
  "authors": ["Katomap"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.katomap.KatomapClient"]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "fabric-api": "*",
    "minecraft": ">=26.3 <26.4",
    "java": ">=25"
  },
  "suggests": {
    "xaeroworldmap": "*",
    "xaerominimap": "*"
  }
}
